---
import Base from '../layouts/Base.astro';
import Visuel from '../components/Visuel.astro';
import ProductCard from '../components/ProductCard.astro';
import { brand } from '../data/brand';
import { produitsVedette, products } from '../data/products';
import { photosDabord } from '../lib/images';
import { artisans } from '../data/artisans';

const misesEnAvant = photosDabord(produitsVedette);
const vignettes = misesEnAvant.slice(0, 3);
const grille = misesEnAvant.slice(0, 8);
const nombreArtisans = artisans.length;

const valeurs = [
  {
    titre: 'Pièce unique',
    texte:
      'Aucune série industrielle. Le pinceau ne repasse jamais deux fois au même endroit : votre bol ne ressemble à aucun autre.',
  },
  {
    titre: 'Fait main',
    texte:
      'Tournées, modelées au colombin ou montées en plaque, puis peintes à main levée. Aucun décalque, aucun pochoir.',
  },
  {
    titre: 'Éthique & durable',
    texte:
      'Rémunération convenue avec l’atelier avant la première cuisson, emballage sans plastique, expédition groupée.',
  },
  {
    titre: 'Traçabilité',
    texte:
      'Chaque pièce nomme sa main, son atelier et sa ville. Vous savez qui l’a peinte et où elle est née.',
  },
];
---

<Base
  titre="Céramique algérienne peinte à la main"
  description={brand.accroche}
  headerSurVisuel={true}
>
  <!-- ------------------------------- Hero ------------------------------- -->
  <section class="relative bg-ardoise text-lin">
    <div class="mx-auto max-w-[1240px] px-5 pb-12 pt-28 sm:px-8 sm:pb-16 sm:pt-32 lg:pb-20 lg:pt-36">
      <div class="grid items-end gap-10 lg:grid-cols-[1fr_0.85fr] lg:gap-14">
        <div>
          <p class="surtitre text-lin/70">Alger — Tlemcen — Ghardaïa — Kabylie</p>
          <h1 class="mt-5 max-w-2xl text-[2.6rem] leading-[1.03] sm:text-6xl lg:text-7xl">
            <em class="italic">La main</em> avant l’objet,<br class="hidden sm:block" />
            {' '}<em class="italic">la terre</em> avant le décor.
          </h1>
          <p class="mt-6 max-w-md text-base leading-relaxed text-lin/80">
            {brand.accroche}
          </p>
          <p class="arabe mt-3 max-w-md text-xl text-lin/70">{brand.baselineArabe}</p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/collection" class="btn btn-primaire">Voir la collection</a>
            <a href="#philosophie" class="btn btn-clair">L’atelier</a>
          </div>

          <!-- Trois vignettes produit -->
          <ul class="mt-10 grid max-w-md grid-cols-3 gap-3 sm:gap-4">
            {
              vignettes.map((produit) => (
                <li>
                  <a href={`/produits/${produit.id}`} class="block rounded-xs">
                    <Visuel
                      src={produit.image}
                      alt={`${produit.nom} — voir la pièce`}
                      ratio="1 / 1"
                      ton="lin"
                    />
                    <span class="mt-2 block text-xs leading-snug text-lin/70">{produit.nom}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Grande nature morte -->
        <div class="lg:pb-2">
          <Visuel
            src="/products/hero-nature-morte.jpg"
            alt="Nature morte d’atelier : qraba calligraphiée, deux tasses peintes et un anthurium sur fond vert"
            legende="Nature morte d’atelier"
            ratio="3 / 4"
            ton="lin"
            priorite={true}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ---------------------------- Philosophie ---------------------------- -->
  <section id="philosophie" class="bg-blanc">
    <div class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
        <div class="lg:pr-6">
          <p class="surtitre">L’atelier</p>
          <h2 class="mt-5 max-w-lg text-4xl leading-[1.06] sm:text-5xl">
            Posséder une pièce <em class="italic text-argile">aussi unique</em> que vous.
          </h2>
          <div class="mt-6 max-w-md space-y-4 text-base leading-relaxed text-mastic">
            <p>
              Une tasse peinte à la main n’est jamais tout à fait droite. Le trait s’épaissit là où
              la main ralentit, l’émail s’accumule au bas de la panse, un pouce laisse sa trace sous
              l’anse. Ces écarts ne sont pas des défauts rattrapés au dernier moment : ils sont ce
              qui reste de la personne qui a fabriqué l’objet.
            </p>
            <p>
              Nous travaillons avec {nombreArtisans} ateliers, de la Casbah d’Alger aux collines de
              Kabylie. Nous ne leur demandons pas de reproduire un modèle à l’identique — nous leur
              demandons de peindre ce qu’ils savent peindre, et nous acceptons que deux pièces d’une
              même série ne soient pas jumelles.
            </p>
            <p>
              Ce que vous posez sur votre table à Paris, à Lyon ou à Marseille a séché sur une
              terrasse, attendu son tour devant un four, et voyagé emballé dans du papier. C’est un
              objet qui a une adresse.
            </p>
          </div>
          <a href="/collection" class="btn btn-ligne mt-8">Découvrir les pièces</a>
        </div>

        <div class="grid grid-cols-2 gap-4 sm:gap-6">
          <Visuel
            src="/products/atelier-mains.jpg"
            alt="Mains d’une céramiste posant un motif au pinceau fin sur un bol encore cru"
            legende="Le geste"
            ratio="3 / 4"
            ton="lin"
            class="mt-8"
          />
          <Visuel
            src="/products/atelier-sechage.jpg"
            alt="Pièces en cours de séchage alignées sur une planche de bois à l’atelier"
            legende="Le séchage"
            ratio="3 / 4"
            ton="profond"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------ Valeurs ------------------------------ -->
  <section id="valeurs" class="bg-lin">
    <div class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 sm:py-20">
      <h2 class="max-w-xl text-3xl leading-tight sm:text-4xl">
        Ce que nous <em class="italic text-argile">garantissons</em>, pièce par pièce.
      </h2>
      <ul class="filet mt-10 grid gap-px border-filet bg-filet sm:grid-cols-2 lg:grid-cols-4">
        {
          valeurs.map((valeur, index) => (
            <li class="bg-lin p-6 sm:p-7">
              <span class="surtitre">0{index + 1}</span>
              <h3 class="mt-3 font-display text-xl text-ardoise">{valeur.titre}</h3>
              <p class="mt-2 text-sm leading-relaxed text-mastic">{valeur.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ------------------------- Grille de produits ------------------------ -->
  <section id="creations" class="bg-blanc">
    <div class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 sm:py-24">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="max-w-lg text-4xl leading-[1.06] sm:text-5xl">
          Nos plus <em class="italic text-argile">belles créations</em>
        </h2>
        <p class="max-w-sm text-sm leading-relaxed text-mastic">
          Un extrait du catalogue : {products.length} pièces réparties entre mugs, bols, tajines,
          plateaux à pâtisseries, qraba, zellige et art mural.
        </p>
      </div>

      <ul class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {
          grille.map((produit, index) => (
            <li>
              <ProductCard produit={produit} ton={index % 3 === 0 ? 'lin' : 'profond'} />
            </li>
          ))
        }
      </ul>

      <div class="mt-14 flex justify-center">
        <a href="/collection" class="btn btn-ligne">Toute la collection</a>
      </div>
    </div>
  </section>

  <!-- -------------------------------- CTA -------------------------------- -->
  <section class="bg-teal-profond text-blanc">
    <div class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 sm:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div>
          <p class="surtitre text-blanc/85">Première main sur les nouveautés</p>
          <h2 class="mt-5 max-w-xl text-4xl leading-[1.06] sm:text-5xl">
            Les pièces partent <em class="italic">avant</em> d’arriver en ligne.
          </h2>
          <p class="mt-5 max-w-md text-base leading-relaxed text-blanc/90">
            Une fournée, c’est vingt à trente pièces. Nous prévenons d’abord celles et ceux qui sont
            inscrits : photos de la sortie de four, nom de l’artisan, et deux jours pour réserver
            avant la mise en ligne.
          </p>

          <form
            class="mt-8 flex max-w-md flex-col gap-3 sm:flex-row"
            method="post"
            action="#"
            aria-describedby="newsletter-aide"
          >
            <div class="flex-1">
              <label for="email" class="surtitre text-blanc/80">Votre e-mail</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="prenom@exemple.fr"
                class="mt-2 min-h-11 w-full rounded-xs border border-blanc/50 bg-blanc px-3 text-ardoise placeholder:text-mastic"
              />
            </div>
            <button type="submit" class="btn btn-clair mt-2 sm:mt-[1.85rem]">
              M’inscrire
            </button>
          </form>
          <p id="newsletter-aide" class="mt-3 text-xs text-blanc/80">
            Environ un message par fournée. Désinscription en un clic. Formulaire de démonstration :
            à brancher sur l’outil d’e-mailing avant mise en ligne.
          </p>
        </div>

        <Visuel
          src="/products/sortie-de-four.jpg"
          alt="Pièces encore tièdes alignées à la sortie du four, avant emballage"
          legende="Sortie de four"
          ratio="4 / 3"
          ton="lin"
        />
      </div>
    </div>
  </section>

  <!-- ---------------------------- Témoignages ---------------------------- -->
  <section id="temoignages" class="bg-lin">
    <div class="mx-auto max-w-[1240px] px-5 py-14 sm:px-8 sm:py-16">
      <div class="max-w-2xl">
        <p class="surtitre">Témoignages</p>
        <h2 class="mt-4 text-3xl leading-tight sm:text-4xl">
          Cette page attend <em class="italic text-argile">vos mots</em>.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-mastic">
          Nous n’inventons pas d’avis. Les premiers retours de clientes et de clients seront publiés
          ici tels qu’ils nous parviendront, avec leur prénom et leur ville — et, quand la pièce s’y
          prête, une photo prise chez eux.
        </p>
        <a href={`mailto:${brand.contact.email}`} class="btn btn-ligne mt-7">
          Nous raconter votre pièce
        </a>
      </div>
    </div>
  </section>
</Base>
