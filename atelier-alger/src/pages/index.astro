---
import Base from '../layouts/Base.astro';
import Packshot from '../components/Packshot.astro';
import Photo from '../components/Photo.astro';
import ProductCard from '../components/ProductCard.astro';
import { brand } from '../data/brand';
import { artisans, getArtisan } from '../data/artisans';
import { getCategorie } from '../data/categories';
import { collections, getCollection } from '../data/collections';
import { ID_PIECE_A_LA_UNE, getProduct } from '../data/products';
import {
  piecesAffichables,
  piecesDeLaCollection,
  piecesDuType,
  vuesDisponibles,
} from '../lib/catalogue';

/* ---- Pièce à la une ---- */
const aLaUne = getProduct(ID_PIECE_A_LA_UNE) ?? piecesAffichables[0];
const artisanUne = getArtisan(aLaUne.artisan);
const vuesUne = vuesDisponibles(aLaUne).slice(0, 2);
const sujetReservation = encodeURIComponent(`Réservation — ${aLaUne.nom} (${aLaUne.commerce.sku})`);

/* ---- Rangées : un type de pièce, puis une collection régionale ----
   Une pièce n'apparaît qu'une fois sur la page : chaque rangée écarte ce qui
   est déjà montré au-dessus. « Tout afficher » mène à la liste complète. */
const dejaMontres = new Set([aLaUne.id]);
const rangee = (titre: string, sousTitre: string, href: string, pieces: typeof piecesAffichables) => {
  const choisies = pieces.filter((p) => !dejaMontres.has(p.id)).slice(0, 4);
  choisies.forEach((p) => dejaMontres.add(p.id));
  return { titre, sousTitre, href, pieces: choisies };
};

const typeQraba = getCategorie('gourdes');
const collectionBerbere = getCollection('terres-berberes');
const rangees = [
  rangee(typeQraba.nom, typeQraba.intro, `/collection/${typeQraba.id}`, piecesDuType(typeQraba.id)),
  rangee(
    collectionBerbere.nom,
    collectionBerbere.intro,
    `/collection/${collectionBerbere.id}`,
    piecesDeLaCollection(collectionBerbere.id),
  ),
].filter((r) => r.pieces.length > 0);

const reassurances = [
  'Peinte à la main : deux pièces ne sont jamais tout à fait identiques.',
  'Réservation par e-mail : la pièce vous est confirmée avant tout paiement.',
  'Emballée à la main, expédiée depuis l’Algérie vers la France.',
];

/* ---- Chiffres clés : tirés des données, aucun chiffre inventé ---- */
const chiffres = [
  { valeur: String(artisans.length), libelle: 'ateliers partenaires' },
  { valeur: String(collections.length), libelle: 'régions d’Algérie' },
  { valeur: '100 %', libelle: 'peint à la main' },
];
---

<Base titre="Céramique algérienne peinte à la main" description={brand.accroche}>
  <!-- --------------------------------------------------------------- *
       Hero : la nature morte en entier, en fond. Le texte se pose sur le
       mur vert à droite de la scène (grand écran) ou sous l'image (mobile).
  ---------------------------------------------------------------- -->
  <section class="relative bg-vert-atelier text-lin" aria-labelledby="titre-hero">
    <div class="relative aspect-[1983/793] w-full">
      <Photo
        src="/products/hero-nature-morte"
        alt="Nature morte d’atelier : qraba calligraphiée, deux tasses peintes et une feuille d’anthurium sur fond vert"
        plein={true}
        priorite={true}
        tailles="100vw"
        class="absolute inset-0"
      />
      <!-- Raccord avec la bande de texte, sur mobile uniquement -->
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-vert-atelier to-transparent md:hidden"
        aria-hidden="true"
      >
      </div>
    </div>

    <div
      class="conteneur relative pb-12 pt-4 md:absolute md:inset-0 md:flex md:items-center md:justify-end md:py-0"
    >
      <div class="max-w-sm md:mr-[2%] lg:mr-[5%]">
        <h1 id="titre-hero" class="text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">
          La main <em class="italic">avant</em> l’objet.
        </h1>
        <p class="mt-4 text-base leading-relaxed text-lin/85">{brand.accroche}</p>
        <a href="/collection" class="btn btn-primaire mt-7">Découvrir les pièces</a>
      </div>
    </div>
  </section>

  <!-- ------------------------- Pièce à la une ------------------------ -->
  <section class="section" aria-labelledby="titre-une">
    <div class="conteneur">
      <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-20">
        <div class:list={['grid gap-3', vuesUne.length > 0 && 'grid-cols-[2fr_1fr]']}>
          <a href={`/produits/${aLaUne.id}`} class="block rounded-xs" aria-label={`Voir la pièce ${aLaUne.nom}`}>
            <Packshot
              src={aLaUne.image}
              alt={`${aLaUne.nom}, vue principale`}
              tailles="(min-width: 1024px) 40vw, 62vw"
            />
          </a>
          {
            vuesUne.length > 0 && (
              <div class="grid content-start gap-3">
                {vuesUne.map((vue, index) => (
                  <Packshot
                    src={vue}
                    alt={`${aLaUne.nom}, détail ${index + 1} du décor peint`}
                    detail={true}
                    tailles="(min-width: 1024px) 20vw, 31vw"
                  />
                ))}
              </div>
            )
          }
        </div>

        <div>
          <p class="surtitre">Pièce à la une</p>
          <h2 id="titre-une" class="mt-4 text-4xl sm:text-5xl">{aLaUne.nom}</h2>
          <p class="mt-4 text-lg text-ardoise">{aLaUne.prix}</p>
          <p class="mt-6 max-w-md leading-relaxed text-mastic">{aLaUne.description}</p>
          <p class="mt-5 text-sm text-mastic">
            Peinte par <span class="text-ardoise">{artisanUne.nom}</span> — {aLaUne.ville},
            {' '}{artisanUne.region}
            <span aria-hidden="true"> · </span>
            {aLaUne.commerce.disponibilite === 'unique' ? 'Pièce unique' : 'Refaite à la demande'}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            {
              aLaUne.reservee ? (
                <span class="btn btn-primaire" aria-disabled="true">
                  Pièce réservée
                </span>
              ) : (
                <a href={`mailto:${brand.contact.email}?subject=${sujetReservation}`} class="btn btn-primaire">
                  Réserver cette pièce
                </a>
              )
            }
            <a href={`/produits/${aLaUne.id}`} class="btn btn-contour">Voir la pièce</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------------- Rangées par collection + réassurance --------------- -->
  {
    rangees.map((r, index) => (
      <>
        <div class="conteneur">
          <p class="reassurance">{reassurances[index]}</p>
        </div>
        <section class="section" aria-labelledby={`rangee-${index}`}>
          <div class="conteneur">
            <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
              <div>
                <h2 id={`rangee-${index}`} class="text-3xl sm:text-4xl">
                  {r.titre}
                </h2>
                <p class="mt-2 max-w-lg text-sm leading-relaxed text-mastic">{r.sousTitre}</p>
              </div>
              <a href={r.href} class="lien-fleche">
                Tout afficher
                <span aria-hidden="true">→</span>
              </a>
            </div>
            <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 lg:grid-cols-4">
              {r.pieces.map((produit) => (
                <li>
                  <ProductCard produit={produit} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      </>
    ))
  }

  <div class="conteneur">
    <p class="reassurance">{reassurances[rangees.length] ?? reassurances[reassurances.length - 1]}</p>
  </div>

  <!-- ------------------------------ Atelier ----------------------------- -->
  <section id="atelier" class="section scroll-mt-20" aria-labelledby="titre-atelier">
    <div class="conteneur">
      <div class="grid items-center gap-12 md:grid-cols-[0.8fr_1fr] lg:gap-24">
        <Photo
          src="/products/atelier-ambiance"
          alt="Feuille d’anthurium, vase de terre et qraba calligraphiée sur une table drapée de vert"
          ratio="3 / 4"
          arche={true}
          tailles="(min-width: 768px) 38vw, 90vw"
          class="mx-auto w-full max-w-md"
        />
        <div>
          <p class="surtitre">L’atelier</p>
          <h2 id="titre-atelier" class="mt-4 max-w-md text-4xl sm:text-5xl">
            Des mains, des villes, <em class="italic text-argile">une signature.</em>
          </h2>
          <p class="mt-6 max-w-md leading-relaxed text-mastic">
            Chaque pièce est tournée ou peinte par un atelier que nous connaissons, d’Alger à la
            Kabylie. Personne n’y reproduit un modèle : deux pièces d’une même série ne sont jamais
            jumelles.
          </p>
          <dl class="filet mt-10 grid grid-cols-3 gap-4 pt-8">
            {
              chiffres.map((chiffre) => (
                <div>
                  <dt class="sr-only">{chiffre.libelle}</dt>
                  <dd>
                    <span class="block font-display text-4xl text-ardoise sm:text-5xl">{chiffre.valeur}</span>
                    <span class="mt-2 block text-xs uppercase tracking-[0.14em] text-mastic" aria-hidden="true">
                      {chiffre.libelle}
                    </span>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ----------------------------- Newsletter --------------------------- -->
  <section class="section bg-vert-atelier text-lin" aria-labelledby="titre-lettre">
    <div class="conteneur">
      <div class="mx-auto max-w-xl text-center">
        <p class="surtitre text-lin/80">Lettre</p>
        <h2 id="titre-lettre" class="mt-4 text-3xl sm:text-4xl">Réassorts et nouveautés</h2>
        <p class="mt-4 leading-relaxed text-lin/85">
          Un message à chaque sortie de four, avec les pièces disponibles avant leur mise en ligne.
        </p>
        <form class="mt-8 flex flex-col gap-3 sm:flex-row" method="post" action="#">
          <label for="email-lettre" class="sr-only">Votre adresse e-mail</label>
          <input
            id="email-lettre"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="Votre adresse e-mail"
            class="champ flex-1 border-transparent"
          />
          <button type="submit" class="btn btn-primaire">S’inscrire</button>
        </form>
        <p class="mt-3 text-xs text-lin/75">Désinscription en un clic. Formulaire à brancher sur l’outil d’e-mailing.</p>
      </div>
    </div>
  </section>
</Base>
