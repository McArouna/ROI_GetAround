---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { categories } from '../data/categories';
import { products, produitsParCategorie } from '../data/products';
---

<Base
  titre="La collection"
  description={`Le catalogue complet : ${products.length} pièces de céramique algérienne peintes à la main, classées par famille d’objets.`}
>
  <section class="bg-lin">
    <div class="mx-auto max-w-[1240px] px-5 pb-10 pt-14 sm:px-8 sm:pb-12 sm:pt-20">
      <p class="surtitre">Catalogue — {products.length} pièces</p>
      <h1 class="mt-5 max-w-2xl text-5xl leading-[1.04] sm:text-6xl">
        Toute la <em class="italic text-argile">collection</em>
      </h1>
      <p class="mt-5 max-w-lg text-base leading-relaxed text-mastic">
        Onze familles d’objets, de la tasse du matin au def accroché au mur. Les pièces marquées
        « pièce unique » ne seront pas refaites à l’identique.
      </p>

      <nav aria-label="Familles d’objets" class="filet mt-9 pt-6">
        <ul class="flex flex-wrap gap-x-2 gap-y-1">
          {
            categories.map((categorie) => (
              <li>
                <a
                  href={`#${categorie.id}`}
                  class="inline-flex min-h-11 items-center rounded-xs border border-filet bg-blanc px-3 text-sm text-ardoise hover:border-argile hover:text-argile"
                >
                  {categorie.nom}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <div class="bg-blanc">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-8">
      {
        categories.map((categorie) => {
          const pieces = produitsParCategorie(categorie.id);
          return (
            <section id={categorie.id} class="filet scroll-mt-24 py-14 first:border-t-0 sm:py-16">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <h2 class="max-w-md text-3xl leading-tight sm:text-4xl">{categorie.nom}</h2>
                <p class="max-w-sm text-sm leading-relaxed text-mastic">{categorie.intro}</p>
              </div>
              <ul class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
                {pieces.map((produit, index) => (
                  <li>
                    <ProductCard produit={produit} ton={index % 2 === 0 ? 'profond' : 'lin'} />
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </div>
</Base>
