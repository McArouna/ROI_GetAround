---
import Base from '../../layouts/Base.astro';
import Visuel from '../../components/Visuel.astro';
import ProductCard from '../../components/ProductCard.astro';
import { brand } from '../../data/brand';
import { getArtisan } from '../../data/artisans';
import { getCategorie } from '../../data/categories';
import { products, type Product } from '../../data/products';

export function getStaticPaths() {
  return products.map((produit) => ({
    params: { slug: produit.id },
    props: { produit },
  }));
}

interface Props {
  produit: Product;
}

const { produit } = Astro.props;
const artisan = getArtisan(produit.artisan);
const categorie = getCategorie(produit.categorie);

const aVoirAussi = products
  .filter((p) => p.id !== produit.id && (p.categorie === produit.categorie || p.artisan === produit.artisan))
  .slice(0, 3);

const tracabilite = [
  { intitule: 'Peinte par', valeur: `${artisan.nom} — ${artisan.atelier}` },
  { intitule: 'Lieu', valeur: `${produit.ville}, ${artisan.region}` },
  { intitule: 'Argile', valeur: produit.tracabilite.argile },
  { intitule: 'Technique', valeur: produit.tracabilite.technique },
  { intitule: 'Cuisson', valeur: produit.tracabilite.cuisson },
  { intitule: 'Dimensions', valeur: produit.tracabilite.dimensions },
  { intitule: 'Entretien', valeur: produit.tracabilite.entretien },
];

const sujetReservation = encodeURIComponent(`Réservation — ${produit.nom} (${produit.commerce.sku})`);
---

<Base titre={produit.nom} description={produit.description}>
  <div class="bg-blanc">
    <div class="mx-auto max-w-[1240px] px-5 sm:px-8">
      <!-- Fil d’Ariane -->
      <nav aria-label="Fil d’Ariane" class="py-5 text-sm text-mastic">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-argile">Accueil</a></li>
          <li aria-hidden="true">—</li>
          <li><a href="/collection" class="hover:text-argile">Collection</a></li>
          <li aria-hidden="true">—</li>
          <li>
            <a href={`/collection#${categorie.id}`} class="hover:text-argile">{categorie.nom}</a>
          </li>
          <li aria-hidden="true">—</li>
          <li aria-current="page" class="text-ardoise">{produit.nom}</li>
        </ol>
      </nav>

      <!-- Galerie + achat -->
      <div class="filet grid gap-10 py-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:py-14">
        <div>
          <Visuel
            src={produit.image}
            alt={`${produit.nom}, vue principale`}
            legende={produit.nom}
            ratio="4 / 5"
            ton="profond"
            priorite={true}
          />
          {
            produit.galerie.length > 0 && (
              <ul class="mt-4 grid grid-cols-2 gap-4">
                {produit.galerie.map((vue, index) => (
                  <li>
                    <Visuel
                      src={vue}
                      alt={`${produit.nom}, vue ${index + 2}`}
                      legende={`Vue ${index + 2}`}
                      ratio="1 / 1"
                      ton={index % 2 === 0 ? 'lin' : 'profond'}
                    />
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="lg:sticky lg:top-8 lg:self-start">
          <p class="surtitre">{categorie.nom}</p>
          <h1 class="mt-4 text-4xl leading-[1.06] sm:text-5xl">{produit.nom}</h1>
          {
            produit.nomArabe && (
              <p class="arabe mt-2 text-2xl text-teal-profond" lang="ar">
                {produit.nomArabe}
              </p>
            )
          }

          <p class="mt-5 text-base leading-relaxed text-mastic">{produit.description}</p>

          <div class="filet mt-7 flex flex-wrap items-baseline gap-x-4 gap-y-1 pt-6">
            <span class="font-display text-3xl text-ardoise">{produit.prix}</span>
            <span class="text-sm text-mastic">
              {produit.commerce.disponibilite === 'unique'
                ? 'Pièce unique — une seule existe'
                : 'Refaite à la demande — jamais à l’identique'}
            </span>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={`mailto:${brand.contact.email}?subject=${sujetReservation}`}
              class="btn btn-primaire"
            >
              Réserver cette pièce
            </a>
            <a href="/collection" class="btn btn-ligne">Voir la collection</a>
          </div>
          <p class="mt-3 text-xs text-mastic">
            Paiement en ligne à venir. Pour l’instant, la réservation se fait par e-mail : nous
            confirmons la pièce, le délai et l’expédition. Référence {produit.commerce.sku}.
          </p>

          <!-- Description longue -->
          <div class="filet mt-8 pt-7">
            <h2 class="font-display text-2xl">La pièce</h2>
            <p class="mt-3 text-base leading-relaxed text-mastic">{produit.descriptionLongue}</p>
          </div>

          <!-- Traçabilité -->
          <div class="filet mt-8 pt-7">
            <h2 class="font-display text-2xl">Traçabilité</h2>
            <dl class="mt-4 grid gap-px border border-filet bg-filet">
              {
                tracabilite.map((ligne) => (
                  <div class="grid grid-cols-[8.5rem_1fr] gap-3 bg-blanc px-4 py-3">
                    <dt class="surtitre pt-0.5">{ligne.intitule}</dt>
                    <dd class="text-sm leading-relaxed text-ardoise">{ligne.valeur}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ----------------------------- L’artisan ----------------------------- -->
  <section class="bg-lin">
    <div class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <Visuel
          src={artisan.portrait}
          alt={`Portrait de ${artisan.nom}, ${artisan.metier.toLowerCase()} à ${artisan.ville}`}
          legende={artisan.nom}
          ratio="3 / 4"
          ton="blanc"
          class="max-w-sm"
        />
        <div>
          <p class="surtitre">L’artisan</p>
          <h2 class="mt-4 text-4xl leading-[1.06] sm:text-5xl">
            {artisan.nom}, <em class="italic text-argile">{artisan.metier.toLowerCase()}</em>
          </h2>
          <p class="mt-3 text-sm text-mastic">
            {artisan.atelier} — {artisan.ville}, {artisan.region}
          </p>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-mastic">{artisan.bio}</p>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-ardoise">
            Cette pièce a été peinte à {produit.ville}. Si vous la commandez à nouveau dans six
            mois, elle sortira de la même main — et elle ne sera pas la même.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ----------------------------- À voir aussi -------------------------- -->
  {
    aVoirAussi.length > 0 && (
      <section class="bg-blanc">
        <div class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8 sm:py-20">
          <h2 class="text-3xl leading-tight sm:text-4xl">
            De la <em class="italic text-argile">même main</em>, ou de la même famille
          </h2>
          <ul class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {aVoirAussi.map((autre, index) => (
              <li>
                <ProductCard produit={autre} ton={index % 2 === 0 ? 'lin' : 'profond'} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>
