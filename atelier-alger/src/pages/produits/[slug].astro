---
/**
 * Fiche produit — version d'attente, alignée sur le nouveau système visuel
 * (4:5, fond uni, aucune case vide). La refonte complète (photo sticky,
 * miniatures, traçabilité en accordéon) suit la validation de l'accueil.
 */
import Base from '../../layouts/Base.astro';
import Packshot from '../../components/Packshot.astro';
import ProductCard from '../../components/ProductCard.astro';
import { brand } from '../../data/brand';
import { getArtisan } from '../../data/artisans';
import { getCategorie } from '../../data/categories';
import type { Product } from '../../data/products';
import { piecesAffichables, piecesLiees, vuesDisponibles } from '../../lib/catalogue';

export function getStaticPaths() {
  return piecesAffichables.map((produit) => ({ params: { slug: produit.id }, props: { produit } }));
}

const { produit } = Astro.props as { produit: Product };
const artisan = getArtisan(produit.artisan);
const categorie = getCategorie(produit.categorie);
const vues = vuesDisponibles(produit);
const liees = piecesLiees(produit, 3);
const sujet = encodeURIComponent(`Réservation — ${produit.nom} (${produit.commerce.sku})`);

const tracabilite = [
  { intitule: 'Peinte par', valeur: `${artisan.nom} — ${artisan.atelier}` },
  { intitule: 'Lieu', valeur: `${produit.ville}, ${artisan.region}` },
  { intitule: 'Argile', valeur: produit.tracabilite.argile },
  { intitule: 'Technique', valeur: produit.tracabilite.technique },
  { intitule: 'Cuisson', valeur: produit.tracabilite.cuisson },
  { intitule: 'Dimensions', valeur: produit.tracabilite.dimensions },
  { intitule: 'Entretien', valeur: produit.tracabilite.entretien },
];
---

<Base titre={produit.nom} description={produit.description}>
  <div class="conteneur">
    <nav aria-label="Fil d’Ariane" class="py-5 text-xs uppercase tracking-[0.14em] text-mastic">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-ardoise">Accueil</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/collection/${categorie.id}`} class="hover:text-ardoise">{categorie.nom}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ardoise">{produit.nom}</li>
      </ol>
    </nav>
  </div>

  <section class="pb-16 pt-4 lg:pb-24">
    <div class="conteneur grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
      <div class:list={['grid gap-3', vues.length > 0 && 'grid-cols-[2fr_1fr]']}>
        <Packshot
          src={produit.image}
          alt={`${produit.nom}, vue principale`}
          badge={produit.reservee ? 'Réservé' : undefined}
          priorite={true}
          tailles="(min-width: 1024px) 38vw, 62vw"
        />
        {
          vues.length > 0 && (
            <div class="grid content-start gap-3">
              {vues.map((vue, index) => (
                <Packshot
                  src={vue}
                  alt={`${produit.nom}, vue ${index + 2}`}
                  detail={vue.includes('-detail-')}
                  tailles="(min-width: 1024px) 19vw, 31vw"
                />
              ))}
            </div>
          )
        }
      </div>

      <div class="lg:pt-6">
        <p class="surtitre">{categorie.nom}</p>
        <h1 class="mt-4 text-4xl sm:text-5xl">{produit.nom}</h1>
        <p class="mt-4 text-lg">{produit.prix}</p>
        <p class="mt-6 max-w-md leading-relaxed text-mastic">{produit.description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          {
            produit.reservee ? (
              <span class="btn btn-primaire" aria-disabled="true">
                Pièce réservée
              </span>
            ) : (
              <a href={`mailto:${brand.contact.email}?subject=${sujet}`} class="btn btn-primaire">
                Réserver cette pièce
              </a>
            )
          }
        </div>
        <p class="mt-3 text-xs text-mastic">
          Pas de paiement en ligne : la réservation se fait par e-mail, la pièce vous est confirmée
          avant tout règlement.
        </p>

        <div class="filet mt-10 pt-8">
          <h2 class="font-display text-2xl">La pièce</h2>
          <p class="mt-3 leading-relaxed text-mastic">{produit.descriptionLongue}</p>
        </div>

        <div class="filet mt-8 pt-8">
          <h2 class="font-display text-2xl">Traçabilité</h2>
          <dl class="mt-4 divide-y divide-filet border-y border-filet">
            {
              tracabilite.map((ligne) => (
                <div class="grid grid-cols-[7.5rem_1fr] gap-3 py-3">
                  <dt class="surtitre pt-0.5">{ligne.intitule}</dt>
                  <dd class="text-sm leading-relaxed">{ligne.valeur}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="filet mt-8 pt-8">
          <p class="surtitre">L’artisan</p>
          <p class="mt-3 font-display text-2xl">
            {artisan.nom}, <em class="italic text-argile">{artisan.metier.toLowerCase()}</em>
          </p>
          <p class="mt-1 text-sm text-mastic">{artisan.atelier} — {artisan.ville}, {artisan.region}</p>
          <p class="mt-4 leading-relaxed text-mastic">{artisan.bio}</p>
        </div>
      </div>
    </div>
  </section>

  {
    liees.length > 0 && (
      <section class="section filet">
        <div class="conteneur">
          <h2 class="text-3xl sm:text-4xl">Pièces associées</h2>
          <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 lg:grid-cols-3">
            {liees.map((autre) => (
              <li>
                <ProductCard produit={autre} tailles="(min-width: 1024px) 31vw, 45vw" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>
