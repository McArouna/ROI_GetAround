---
/** Marque textuelle + signe dessiné (jamais d’emoji comme icône). */
interface Props {
  class?: string;
}
const { class: classe = '' } = Astro.props;
---

<svg
  viewBox="0 0 22 22"
  fill="none"
  aria-hidden="true"
  class={`h-5 w-5 shrink-0 ${classe}`}
>
  <path d="M2.5 8h17c0 5.8-3.8 10.5-8.5 10.5S2.5 13.8 2.5 8Z" stroke="currentColor" stroke-width="1.1" />
  <path d="M7.5 8c0-3.1 1.57-5.6 3.5-5.6S14.5 4.9 14.5 8" stroke="currentColor" stroke-width="1.1" />
  <path d="M6 12.5h10" stroke="currentColor" stroke-width="1.1" stroke-dasharray="1.5 2.2" />
</svg>
