---
import Packshot from './Packshot.astro';
import { getArtisan } from '../data/artisans';
import type { Product } from '../data/products';

interface Props {
  produit: Product;
  /** Largeur d'affichage de la vignette, pour le choix de densité. */
  tailles?: string;
}

const { produit, tailles = '(min-width: 1024px) 23vw, 45vw' } = Astro.props;
const artisan = getArtisan(produit.artisan);
---

<article>
  <a href={`/produits/${produit.id}`} class="group block rounded-xs">
    <Packshot
      src={produit.image}
      alt={`${produit.nom}, peint par ${artisan.nom} à ${produit.ville}`}
      badge={produit.reservee ? 'Réservé' : undefined}
      tailles={tailles}
    />
    <div class="mt-4 flex items-baseline justify-between gap-3">
      <h3 class="font-display text-[1.0625rem] leading-snug text-ardoise group-hover:text-argile">
        {produit.nom}
      </h3>
      <p class="shrink-0 text-sm text-mastic">{produit.prix}</p>
    </div>
  </a>
</article>
