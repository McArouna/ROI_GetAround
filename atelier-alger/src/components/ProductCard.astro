---
import Visuel from './Visuel.astro';
import { getArtisan } from '../data/artisans';
import { getCategorie } from '../data/categories';
import type { Product } from '../data/products';

interface Props {
  produit: Product;
  /** Alterne les fonds de placeholder pour éviter l’effet damier uniforme. */
  ton?: 'lin' | 'profond' | 'blanc';
}

const { produit, ton = 'profond' } = Astro.props;
const artisan = getArtisan(produit.artisan);
const categorie = getCategorie(produit.categorie);
---

<article class="group flex h-full flex-col">
  <a href={`/produits/${produit.id}`} class="flex h-full flex-col rounded-xs">
    <Visuel
      src={produit.image}
      alt={`${produit.nom} — ${categorie.nom}, peint par ${artisan.nom} à ${produit.ville}`}
      legende={produit.nom}
      ratio="4 / 5"
      ton={ton}
      class="transition-opacity duration-300 group-hover:opacity-90"
    />
    <div class="flex flex-1 flex-col pt-4">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="font-display text-lg leading-snug text-ardoise group-hover:text-argile">
          {produit.nom}
        </h3>
        <span class="shrink-0 text-sm text-ardoise">{produit.prix}</span>
      </div>
      {
        produit.nomArabe && (
          <p class="arabe mt-1 text-base text-mastic" aria-hidden="true">
            {produit.nomArabe}
          </p>
        )
      }
      <p class="mt-1.5 text-sm text-mastic sm:mt-auto sm:pt-1.5">
        Peint par <span class="text-teal-profond">{artisan.nom}</span> — {produit.ville}
      </p>
    </div>
  </a>
</article>
