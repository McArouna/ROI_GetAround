---
/**
 * Photo d'ambiance (atelier, artisan, nature morte).
 * Cadrage photographique (`cover`), sans ombre ajoutée. `arche` lui donne
 * le cadre en arche réservé aux ambiances — jamais aux produits.
 */
import { jeuImage } from '../lib/images';

interface Props {
  /** Chemin de base, sans extension. */
  src: string;
  alt: string;
  /** Ratio CSS du cadre, ex. « 3 / 4 ». Ignoré si `plein`. */
  ratio?: string;
  arche?: boolean;
  /** Remplit son conteneur au lieu de tenir un ratio. */
  plein?: boolean;
  priorite?: boolean;
  tailles?: string;
  class?: string;
}

const {
  src,
  alt,
  ratio = '3 / 4',
  arche = false,
  plein = false,
  priorite = false,
  tailles,
  class: classe = '',
} = Astro.props;

const jeu = jeuImage(src);
---

<figure
  class:list={['photo', arche && 'photo--arche', classe]}
  style={plein ? undefined : `aspect-ratio: ${ratio};`}
>
  {
    jeu.existe && (
      <picture>
        <source type="image/webp" srcset={jeu.webp} sizes={tailles} />
        <source type={jeu.typeRepli} srcset={jeu.repli} sizes={tailles} />
        <img
          src={jeu.source}
          alt={alt}
          loading={priorite ? 'eager' : 'lazy'}
          fetchpriority={priorite ? 'high' : 'auto'}
          decoding="async"
          class="photo__image"
        />
      </picture>
    )
  }
</figure>
