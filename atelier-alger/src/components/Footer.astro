---
import { brand, liensFooter, lienArtisanPartenaire } from '../data/brand';

const annee = new Date().getFullYear();
---

<footer id="contact" class="border-t border-filet">
  <div class="conteneur py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="font-display text-lg text-ardoise">{brand.nom}</p>
        <a
          href={`mailto:${brand.contact.email}`}
          class="mt-1 inline-flex min-h-11 items-center text-sm text-mastic hover:text-argile"
        >
          {brand.contact.email}
        </a>
      </div>
      <nav aria-label="Informations">
        <ul class="flex flex-wrap gap-x-7 gap-y-1">
          {
            liensFooter.map((lien) => (
              <li>
                <a href={lien.href} class="inline-flex min-h-11 items-center text-sm text-mastic hover:text-ardoise">
                  {lien.libelle}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={lienArtisanPartenaire.href}
              class="inline-flex min-h-11 items-center text-sm text-ardoise underline decoration-filet underline-offset-4 hover:decoration-ardoise"
            >
              {lienArtisanPartenaire.libelle}
            </a>
          </li>
        </ul>
      </nav>
    </div>
    <p class="filet mt-8 pt-6 text-xs text-mastic">© {annee} {brand.nom} — {brand.promesse}.</p>
  </div>
</footer>
