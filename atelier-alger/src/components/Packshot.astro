---
/**
 * Photo produit — le même cadre partout sur le site.
 *
 *  - ratio 4:5, fond uni identique (dérivé de la palette) ;
 *  - produit détouré occupant ~70 % du cadre : la marge est cuite dans le
 *    fichier par scripts/preparer-images.mjs, aucun zoom au cas par cas ;
 *  - une seule ombre douce, posée en `drop-shadow` (elle suit le détourage) ;
 *  - WebP + PNG de repli, 1× et 2× ; `lazy` sauf au-dessus de la ligne de
 *    flottaison.
 *
 * `detail` : gros plan photographique (« <id>-detail-N »), même cadre 4:5,
 * image pleine et sans ombre ajoutée.
 */
import { jeuImage } from '../lib/images';

interface Props {
  /** Chemin de base, sans extension : « /products/tasse-tanit ». */
  src: string;
  alt: string;
  /** Petite étiquette en haut à gauche (« Réservé »). */
  badge?: string;
  detail?: boolean;
  priorite?: boolean;
  /** Largeur d'affichage, pour le choix de densité. */
  tailles?: string;
  class?: string;
}

const { src, alt, badge, detail = false, priorite = false, tailles, class: classe = '' } = Astro.props;
const jeu = jeuImage(src);
---

<figure class:list={['packshot', detail && 'packshot--detail', classe]}>
  {badge && <span class="badge">{badge}</span>}
  {
    jeu.existe && (
      <picture>
        <source type="image/webp" srcset={jeu.webp} sizes={tailles} />
        <source type={jeu.typeRepli} srcset={jeu.repli} sizes={tailles} />
        <img
          src={jeu.source}
          alt={alt}
          width="800"
          height="1000"
          loading={priorite ? 'eager' : 'lazy'}
          fetchpriority={priorite ? 'high' : 'auto'}
          decoding="async"
          class="packshot__image"
        />
      </picture>
    )
  }
</figure>
