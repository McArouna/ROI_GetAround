---
/**
 * Visuel produit : affiche la photo si elle existe dans /public/,
 * sinon un placeholder AU MÊME FORMAT et à la même position, pour que la
 * photographie du client vienne s’y substituer sans décaler la mise en page.
 */
import { photoExiste } from '../lib/images';

interface Props {
  src: string;
  /** Texte alternatif — obligatoire. */
  alt: string;
  /** Ratio CSS, ex. '4 / 5'. Identique pour la photo et le placeholder. */
  ratio?: string;
  /** Légende affichée dans le placeholder (nom de la pièce). */
  legende?: string;
  /** Classes supplémentaires sur le conteneur. */
  class?: string;
  /** Chargement prioritaire pour le visuel du hero. */
  priorite?: boolean;
  /** Fond du placeholder. */
  ton?: 'lin' | 'profond' | 'blanc';
}

const {
  src,
  alt,
  ratio = '4 / 5',
  legende,
  class: classe = '',
  priorite = false,
  ton = 'lin',
} = Astro.props;

const fonds = {
  lin: 'bg-lin',
  profond: 'bg-lin-profond',
  blanc: 'bg-blanc',
} as const;

const disponible = photoExiste(src);
---

<figure class={`relative overflow-hidden rounded-xs ${fonds[ton]} ${classe}`} style={`aspect-ratio: ${ratio};`}>
  {
    disponible ? (
      <img
        src={src}
        alt={alt}
        loading={priorite ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priorite ? 'high' : 'auto'}
        class="h-full w-full object-cover"
      />
    ) : (
      <div
        class="flex h-full w-full flex-col items-center justify-center gap-3 border border-filet px-5 text-center"
        role="img"
        aria-label={alt}
      >
        <svg
          width="26"
          height="26"
          viewBox="0 0 26 26"
          fill="none"
          aria-hidden="true"
          class="text-argile/45"
        >
          <path
            d="M4 9.5h18c0 6.1-4.03 11-9 11s-9-4.9-9-11Z"
            stroke="currentColor"
            stroke-width="1"
          />
          <path d="M9.5 9.5c0-3.2 1.57-5.8 3.5-5.8s3.5 2.6 3.5 5.8" stroke="currentColor" stroke-width="1" />
        </svg>
        {legende && (
          <span class="font-display text-base leading-tight text-ardoise/75">{legende}</span>
        )}
        <span class="surtitre">Photo à venir</span>
      </div>
    )
  }
</figure>
